# Copy this file to .env and fill in real values.

# Required for authenticated endpoints (currently only /insert-cv,
# /bulk-insert-cv - see the auth-gap fix planned for parse/score/search)
API_KEY=your-secret-api-key-here

# Required for embedding generation - either name works, embedder.py
# checks GEMINI_API_KEY first, falls back to GOOGLE_API_KEY
GEMINI_API_KEY=your-gemini-api-key-here

# Weaviate connection - defaults to http://weaviate:8080 if unset,
# but docker-compose.yml expects this exact value
VECTOR_DB_HOST=http://cv-rag-vector-db:8080
